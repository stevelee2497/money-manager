{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jupiter-wallet-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"routes": [{ "pattern": "api-wallet.quoctran.qzz.io", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jupiter-wallet-db",
			"database_id": "ed64c373-5c6a-4eb8-ba76-1a69c69c1aff",
			"migrations_dir": "migrations"
		},
		{
			"binding": "jupiter_wallet_db",
			"database_name": "jupiter-wallet-db",
			"database_id": "ed64c373-5c6a-4eb8-ba76-1a69c69c1aff",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "ICONS",
			"bucket_name": "jupiter-wallet-icons"
		},
		{
			"bucket_name": "jupiter-wallet-icons",
			"binding": "jupiter_wallet_icons",
			"remote": true
		}
	],
	"vars": {
		"AUTH0_DOMAIN": "dev-stevenqt.us.auth0.com",
		"AUTH0_AUDIENCE": "https://jupiter-wallet-api",
		"ALLOWED_ORIGINS": "http://localhost:5173,https://jupiter-wallet.pages.dev,https://wallet.quoctran.qzz.io"
	}
}